server {
    listen {{PORT}};
    server_name {{DOMAIN}};
    root /var/www/{{DOMAIN}};
    index index.html index.php;

    {{SSL_BLOCK}}

    {{SECURITY_HEADERS}}

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
    }
}
